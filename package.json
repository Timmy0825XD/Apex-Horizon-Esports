{
  "name": "apex-horizon-esports",
  "version": "0.1.0",
  "private": true,
  "description": "Discord tournament operator bot",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "test": "tsx --test test/transcript.test.ts test/schedule-conflicts.test.ts test/deadline.test.ts test/auto-room-slot.test.ts test/audit-card.test.ts test/report-checks.test.ts test/ban-watch.test.ts test/role-mass-view.test.ts test/bot-panels.test.ts test/panel-guides.test.ts test/panel-tournament.test.ts",
    "thumbnail:preview": "tsx scripts/thumbnail-preview.ts",
    "start": "node dist/index.js",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.11",
    "@prisma/client": "^6.16.1",
    "discord.js": "^14.22.1",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "prisma": "^6.16.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
